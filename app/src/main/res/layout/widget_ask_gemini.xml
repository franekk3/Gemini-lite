<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ask_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/ask_widget_bar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_search_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/ask_widget_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_spark" />

        <TextView
            android:id="@+id/ask_widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/widget_ask_label"
            android:textColor="@color/widget_hint"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/ask_widget_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_voice_description"
            android:padding="9dp"
            android:src="@drawable/ic_mic" />
    </LinearLayout>
</FrameLayout>
