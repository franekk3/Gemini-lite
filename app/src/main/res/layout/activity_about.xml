<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/about_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/about_back"
                android:src="@drawable/ic_arrow_back" />

            <ImageView
                android:id="@+id/about_logo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_spark" />

            <TextView
                android:id="@+id/about_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/about_title"
                android:textColor="@color/widget_text"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/about_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/about_description"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/about_section_project"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.1"
            android:text="@string/about_project_section"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/about_github"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/about_github"
            android:textColor="@color/brand_violet"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/about_section_widgets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.1"
            android:text="@string/about_widgets_section"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/about_widget_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/about_widgets_hint"
            android:textColor="@color/widget_hint"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/about_widget_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/about_theme_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brand_violet"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/about_widget_auto"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/about_theme_bright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brand_violet"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/about_widget_bright"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/about_theme_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/brand_violet"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/about_widget_dark"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/about_section_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.1"
            android:text="@string/about_section"
            android:textColor="@color/widget_hint"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/about_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/about_disclaimer"
            android:textColor="@color/widget_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/about_license"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_license"
            android:textColor="@color/widget_hint"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
